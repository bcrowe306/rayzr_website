---
// Feature cards from the engine's docs/features.json (via npm run sync).
// highlight: only the ones marked for the landing page.
import { Icon } from '@astrojs/starlight/components';
import { features, type Feature } from '../lib/site-data';

interface Props {
	highlight?: boolean;
	group?: string;
}
const { highlight = false, group } = Astro.props;
const list: Feature[] = features().features.filter((f) => (!highlight || f.highlight) && (!group || f.group === group));
---

<div class="rz-cards">
	{
		list.map((f) => (
			<article class="rz-card">
				<div class="rz-card__icon">
					<Icon name={f.icon as never} size="1.5rem" />
				</div>
				<h3>{f.title}</h3>
				<p>{f.description}</p>
				{f.url && (
					<a class="rz-card__link" href={f.url}>
						Learn more <span aria-hidden="true">→</span>
					</a>
				)}
			</article>
		))
	}
</div>
