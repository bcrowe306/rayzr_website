---
// Starlight's header with the site's own navigation (Docs, Features,
// Download, Contact) next to the search box.
import Default from '@astrojs/starlight/components/Header.astro';
import { docsBase } from '../lib/site-data';

const path = Astro.url.pathname;
const nav = [
	{ label: 'Docs', href: docsBase(), active: path.startsWith('/docs/') },
	{ label: 'Features', href: '/features/', active: path.startsWith('/features/') },
	{ label: 'Download', href: '/download/', active: path.startsWith('/download/') },
	{ label: 'Contact', href: '/contact/', active: path.startsWith('/contact/') },
];
---

<div class="rz-header">
	<Default />
	<nav class="rz-nav" aria-label="Site">
		{nav.map((n) => <a href={n.href} aria-current={n.active ? 'page' : undefined}>{n.label}</a>)}
	</nav>
</div>

<style>
	.rz-header {
		display: flex;
		align-items: center;
		gap: 1rem;
		height: 100%;
	}
	.rz-header > :global(.header) {
		flex: 1;
		min-width: 0;
	}
	.rz-nav {
		display: none;
		gap: 1.25rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		white-space: nowrap;
	}
	.rz-nav a {
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
	.rz-nav a:hover,
	.rz-nav a[aria-current='page'] {
		color: var(--sl-color-accent-high);
	}
	@media (min-width: 72rem) {
		.rz-nav {
			display: flex;
		}
	}
</style>
