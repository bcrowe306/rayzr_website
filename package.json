{
  "name": "rayzr-website",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "build:full": "npm run sync && astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify-deploy.mjs",
    "deploy": "wrangler pages deploy dist --project-name rayzr-website --branch main --commit-dirty=true",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.7",
    "astro": "^7.2.10",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "starlight-links-validator": "^0.27.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "private": true,
  "description": "The Rayzr website and documentation (rayzr.app)",
  "engines": {
    "node": ">=22.23.4"
  }
}
